SERVICE_NAME=ticketing
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://tusumba:tusumba@localhost:5432/tusumba
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# events-service: is_free, дата и статус мероприятия (GET /internal/events/{id})
EVENTS_URL=http://localhost:8001
# Публичный ключ Identity в PEM, для разработки: uv run python -m tusumba_common.testing dev-keys
JWT_PUBLIC_KEY=
SERVICE_TOKEN=dev-service-token
